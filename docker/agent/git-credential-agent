#!/usr/bin/env bash
# git credential helper: the agent's own repository gets the write token,
# every other GitHub repository gets the read token. This only chooses a
# token; what each token may do is enforced by GitHub.
[ "${1:-}" = "get" ] || exit 0

declare -A kv
while IFS='=' read -r key value; do
  [ -z "$key" ] && break
  kv["$key"]="$value"
done

[ "${kv[host]:-}" = "github.com" ] || exit 0
path="${kv[path]:-}"; path="${path%.git}"; path="${path%/}"
own="${GH_OWNER}/${AGENT_REPO}"

if [ "${path,,}" = "${own,,}" ]; then
  token_file=/run/secrets/write_token
else
  token_file=/run/secrets/read_token
fi

echo "username=x-access-token"
echo "password=$(tr -d '[:space:]' < "$token_file")"
