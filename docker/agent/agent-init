#!/usr/bin/env bash
# Container entrypoint: clone the agent's own repository on first start,
# then idle until someone attaches (scripts/agent.sh or VS Code).
# The clone is retried for a few minutes, so a proxy that is still starting
# (or briefly down) doesn't leave the agent without its repository.
set -uo pipefail
dir="/workspace/${AGENT_REPO}"
url="https://github.com/${GH_OWNER}/${AGENT_REPO}.git"

if [ ! -d "${dir}/.git" ]; then
  for attempt in $(seq 1 30); do
    if git clone -q "$url" "$dir"; then
      echo "agent-init: cloned ${GH_OWNER}/${AGENT_REPO}"
      break
    fi
    echo "agent-init: clone attempt ${attempt} failed; retrying in 10s" >&2
    sleep 10
  done
  [ -d "${dir}/.git" ] || echo "agent-init: giving up on cloning ${GH_OWNER}/${AGENT_REPO}; check tokens and proxy, then restart this container" >&2
fi

# Install elan if the shared volume doesn't have it yet, and the toolchain Lasm
# requires, so the first `lake build` is a build rather than a download. The
# default toolchain is left alone: it belongs to every project sharing the
# volume. Then register lean-lsp-mcp with Claude Code, in the shared config
# volume. Every agent starts at once and all of this writes to shared volumes,
# so the agents take turns.
(
  flock 9
  if [ ! -x "$HOME/.elan/bin/elan" ]; then
    curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
      | sh -s -- -y --default-toolchain none --no-modify-path
  fi
  elan toolchain install "${LEAN_TOOLCHAIN}" \
    || echo "agent-init: couldn't install ${LEAN_TOOLCHAIN}; check the proxy, then restart this container" >&2
  claude mcp add --scope user lean-lsp -- lean-lsp-mcp >/dev/null 2>&1 || true
) 9>"$HOME/.claude/.agent-init.lock"

exec sleep infinity
