#!/usr/bin/env bash
# One unattended Claude session, started by watch-work inside tmux so that
# scripts/agent.sh can attach to it. dontAsk denies anything not allowed by
# managed-settings.json instead of waiting for a prompt no one will answer.
state=/workspace/.inkproof
claude --permission-mode dontAsk "$(cat "$state/prompt")"
echo "$?" > "$state/exit-status"
