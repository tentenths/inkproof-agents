# Copy to .env and edit.

# GitHub organisation that owns the repositories. Fine-grained tokens for a
# machine user need the repositories to be in an organisation it belongs to.
GH_OWNER=your-organisation

# Every repository in this project starts with this prefix
# (inkproof-core, inkproof-scale, ...). Status reports filter on it.
REPO_PREFIX=inkproof-

# The machine user the agents act as, its commit email, and your username.
# Only issues and comments by these accounts, and at level 3 the GitHub App's
# (APP_BOT), reach the agents.
MACHINE_USER=your-machine-user
MACHINE_EMAIL=machine-user@example.com
HUMAN_USER=your-username

# Must match the host user that owns secrets/ (id -u ; id -g).
HOST_UID=1000
HOST_GID=1000

# Autonomy level 3 only (see README, "Setting up level 3"): the GitHub App's ID,
# from its settings page, and its account, the App's slug followed by [bot].
# Leave both unset below level 3.
# APP_ID=123456
# APP_BOT=inkproof-gatekeeper[bot]

# Optional; the defaults are shown.
# How often each agent's watcher polls GitHub (seconds). The agents share the
# machine user's limit of 5,000 GitHub requests an hour.
# POLL_INTERVAL=300
# Runs each agent may start per day (UTC), and how long an unattended run may
# stay busy before it is stopped (minutes).
# MAX_RUNS_PER_DAY=20
# MAX_RUN_MINUTES=240
# How often the gatekeeper polls GitHub (seconds), under the App's own limit.
# GATEKEEPER_POLL_INTERVAL=60